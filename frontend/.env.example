# Copy to .env.local and fill in.

# Which GenLayer network to talk to. There is one: `studio-dev`, chain 61997.
# Contract, consumer, every score and this app all live there.
#
# `studioDevnet` arrived in genlayer-js 2.0.0-rc.1; the 1.x line did not carry
# it, so an older SDK cannot resolve this network at all.
NEXT_PUBLIC_GENLAYER_NETWORK=studio-dev

# Deployed TokenScope contract, rubric 1.1.0, v0.6 contract format.
# NETWORK-SPECIFIC: a mismatch between this and the network above is silent —
# every read simply returns not-found.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x1C97EFD1001BD26D5A41D1bBe4724302ee2Bb6E5

# RiskConsumer, the composability demo. Optional — only the docs page shows it.
# It is constructed against a specific oracle, so it must match the TokenScope
# address above.
NEXT_PUBLIC_CONSUMER_ADDRESS=0xAc501Bd4fd71A64AE61FC9Db42Ae5a25bED7Eea0

# ─── Studio RPC relay (app/api/rpc) ─────────────────────────────────────────
# The browser talks to /api/rpc instead of Studio directly. Studio serves CORS
# headers on success and drops them on its 429s, so an exhausted rate limit
# would reach the page as "No 'Access-Control-Allow-Origin' header is present"
# rather than as the rate-limit error it is. Relaying through our own origin
# keeps the real reason readable. Server-side requests skip the relay: they
# have no same-origin policy to trip over.
#
# Both vars below are optional and neither is NEXT_PUBLIC_ — the browser must
# go through the relay, not around it.

# Where the relay forwards to. Defaults to the SDK's own Studio Devnet URL so
# it cannot drift from the chain the client talks to.
# GENLAYER_RPC_UPSTREAM=https://studio-dev.genlayer.com/api

# Extra browser origins allowed to call the relay, comma-separated. Same-origin
# always works and needs no entry. Deliberately not `*`: a wildcard would let
# any page on the internet spend this deployment's Studio quota.
# RPC_PROXY_ALLOWED_ORIGINS=https://tokenscope-two.vercel.app
