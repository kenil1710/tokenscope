# Copy to .env.local and fill in.

# Which GenLayer network to talk to: `studionet` or `bradbury`.
# Defaults to studionet when unset.
#
# Rubric 1.1.0 is STUDIONET ONLY, and not by choice: as of 2026-09-19 Bradbury
# refuses any transaction whose gas limit exceeds 2**24, which caps a contract
# at roughly 20 KB of source. TokenScope is 50,779 bytes. The 1.0.0 artifact
# that is already live on Bradbury cannot be redeployed today either - see
# docs/PROBE.md section 11. Point at bradbury to read the 1.0.0 records; point
# at studionet for the milestone features.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Deployed TokenScope contract. NETWORK-SPECIFIC — each network has its own
# deploy, so this must always be changed together with the network above. A
# mismatch is silent: every read simply returns not-found.
#   studionet  0x19063FE1702dAAA12a3FD52917A8d4abf80e3d88   rubric 1.1.0
#   studionet  0xaC6B3575D82825533cA7E35fE8C57c9075b74E95   rubric 1.0.0
#   bradbury   0xbAAF6f0151D728984445fc42edAC84e13241d4E6   rubric 1.0.0
NEXT_PUBLIC_CONTRACT_ADDRESS=0x19063FE1702dAAA12a3FD52917A8d4abf80e3d88

# RiskConsumer, the composability demo. Optional — only the docs page shows it.
# Each one is constructed against a specific oracle, so it must match the
# TokenScope address above.
#   studionet  0xcb9c1E7214B4e610c28A3E8242d9bc2b793A8193  -> 1.1.0 oracle
#   studionet  0x5F033B3A71215C09f89fbc8F650d0Fbfc65e4C28  -> 1.0.0 oracle
#   bradbury   0x9DbdC862e5A35AC0126cd47d4B105E679A2Dd9ee  -> 1.0.0 oracle
NEXT_PUBLIC_CONSUMER_ADDRESS=0xcb9c1E7214B4e610c28A3E8242d9bc2b793A8193

# ─── Studionet RPC relay (app/api/rpc) ───────────────────────────────────────
# On studionet the browser talks to /api/rpc instead of Studio directly. Studio
# drops its CORS headers on 429s, so an exhausted rate limit reaches the page as
# "No 'Access-Control-Allow-Origin' header is present" rather than as the
# rate-limit error it is. Relaying through our own origin keeps it readable.
# Bradbury sets the headers on errors too, so it stays direct.
# Both vars are optional and neither is NEXT_PUBLIC_ — the browser must go
# through the relay, not around it.

# Where the relay forwards to. Defaults to the SDK's own Studionet URL.
# GENLAYER_RPC_UPSTREAM=https://studio.genlayer.com/api

# Extra browser origins allowed to call the relay, comma-separated. Same-origin
# always works and needs no entry. Deliberately not `*`: a wildcard would let
# any page on the internet spend this deployment's Studio quota.
# RPC_PROXY_ALLOWED_ORIGINS=https://tokenscope-two.vercel.app
